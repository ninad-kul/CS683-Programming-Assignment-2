#include "cache.h"
#include <iostream>
#include <cstdint>

// ------------------------------ parameters ------------------------------
#define IPT_BITS         6
#define IPT_SIZE         (1 << IPT_BITS)     // 64 entries, direct mapped
#define IP_TAG_BITS      8
#define LAST_CL_BITS     16                  // low bits of last cache-line address
#define MAX_STRIDE       63                  // |stride| <= 63 lines (same-page prefetch only)
#define CONF_MAX         3                   // 2-bit uniform confidence
#define UNIFORM_CONF     1                   // >=1: same stride seen twice in a row
#define SIG_BITS         9
#define PT_SIZE          (1 << SIG_BITS)     // 512 entries
#define PT_CONF_MAX      3
#define PT_CONF_MIN      2                   // confidence needed to prefetch from the pattern table
#define PFT_SIZE         64                  // prefetch-tracking table (accuracy checker)
#define PFT_TAG_BITS     12
#define EPOCH            128                 // issued prefetches per accuracy epoch
#define ACC_HIGH         60                  // % -> degree DEG_HIGH
#define ACC_LOW          30                  // % -> degree DEG_MID, below -> DEG_LOW
#define DEG_HIGH         4
#define DEG_MID          2
#define DEG_LOW          1

// ------------------------------ structures ------------------------------
struct IPT_ENTRY {
    bool     valid = false;      // 1 bit
    uint8_t  tag = 0;            // 8 bits
    uint16_t last_cl = 0;        // 16 bits
    int8_t   last_stride = 0;    // 7 bits (signed)
    uint8_t  conf = 0;           // 2 bits
    uint16_t sig = 0;            // 9 bits
};
struct PT_ENTRY  { int8_t stride = 0; uint8_t conf = 0; };   // 7 + 2 bits
struct PFT_ENTRY { bool valid = false; uint16_t tag = 0; };  // 1 + 12 bits

static IPT_ENTRY ipt[IPT_SIZE];
static PT_ENTRY  pt[PT_SIZE];
static PFT_ENTRY pft[PFT_SIZE];

static uint8_t degree = DEG_HIGH;     // 3 bits
static uint8_t epoch_issued = 0;      // 8 bits
static uint8_t epoch_useful = 0;      // 8 bits

static uint64_t st_issued = 0, st_useful = 0, st_uniform = 0, st_pattern = 0;

// ------------------------------ helpers ------------------------------
static inline uint16_t next_sig(uint16_t sig, int64_t stride)
{
    return (uint16_t)(((sig << 3) ^ (uint16_t)(stride & 0x3F)) & (PT_SIZE - 1));
}
static inline bool same_page(uint64_t a_cl, uint64_t b_cl) { return (a_cl >> 6) == (b_cl >> 6); }

static inline void pft_lookup_useful(uint64_t cl)
{
    PFT_ENTRY &e = pft[cl & (PFT_SIZE - 1)];
    if (e.valid && e.tag == ((cl >> 6) & ((1 << PFT_TAG_BITS) - 1))) {
        e.valid = false;
        st_useful++;
        if (epoch_useful < 255) epoch_useful++;
    }
}
static inline bool pft_present(uint64_t cl)
{
    const PFT_ENTRY &e = pft[cl & (PFT_SIZE - 1)];
    return e.valid && e.tag == ((cl >> 6) & ((1 << PFT_TAG_BITS) - 1));
}
static inline void pft_insert(uint64_t cl)
{
    PFT_ENTRY &e = pft[cl & (PFT_SIZE - 1)];
    e.valid = true;
    e.tag = (cl >> 6) & ((1 << PFT_TAG_BITS) - 1);
}
static void update_degree()
{
    if (epoch_issued < EPOCH) return;
    uint32_t acc = (epoch_useful * 100u) / epoch_issued;
    degree = (acc >= ACC_HIGH) ? DEG_HIGH : (acc >= ACC_LOW) ? DEG_MID : DEG_LOW;
    epoch_issued = 0;
    epoch_useful = 0;
}

// ------------------------------ ChampSim interface ------------------------------
void CACHE::l1d_prefetcher_initialize()
{
    std::cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)" << std::endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    if (type == PREFETCH) return;

    uint64_t cl = addr >> LOG2_BLOCK_SIZE;
    pft_lookup_useful(cl);                         // accuracy checker: demand hit on a prefetched line

    // issue helper: same page, dedup, MSHR-based fill level (same rule as IP-stride)
    auto issue = [&](uint64_t pf_cl) -> bool {
        if (!same_page(pf_cl, cl)) return false;
        if (pft_present(pf_cl)) return true;       // already prefetched recently: skip, keep walking
        int fill = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
        if (!prefetch_line(ip, addr, pf_cl << LOG2_BLOCK_SIZE, fill, 0)) return false;
        pft_insert(pf_cl);
        st_issued++;
        if (epoch_issued < 255) epoch_issued++;
        return true;
    };

    // ---- IP table lookup (direct mapped, tagged) ----
    uint64_t h = ip ^ (ip >> 7) ^ (ip >> 17);
    IPT_ENTRY &t = ipt[h & (IPT_SIZE - 1)];
    uint8_t tag = (h >> IPT_BITS) & ((1 << IP_TAG_BITS) - 1);

    if (!t.valid || t.tag != tag) {                // new IP: allocate
        t.valid = true; t.tag = tag;
        t.last_cl = (uint16_t)cl; t.last_stride = 0; t.conf = 0; t.sig = 0;
        return;
    }

    int16_t d = (int16_t)((uint16_t)cl - t.last_cl);   // signed modular difference
    t.last_cl = (uint16_t)cl;
    if (d == 0) return;
    if (d > MAX_STRIDE || d < -MAX_STRIDE) {       // cannot be prefetched within a page
        t.last_stride = 0; t.conf = 0;
        return;
    }
    int64_t stride = d;

    // ---- uniform confidence ----
    if (stride == t.last_stride) { if (t.conf < CONF_MAX) t.conf++; }
    else                         { if (t.conf > 0) t.conf--; }

    // ---- train pattern table: (old signature) -> stride ----
    PT_ENTRY &pe = pt[t.sig];
    if (pe.stride == stride)      { if (pe.conf < PT_CONF_MAX) pe.conf++; }
    else if (pe.conf > 0)         { pe.conf--; }
    else                          { pe.stride = (int8_t)stride; pe.conf = 1; }
    t.sig = next_sig(t.sig, stride);

    update_degree();

    // ---- prediction ----
    if (stride == t.last_stride && t.conf >= UNIFORM_CONF) {
        // uniform stride has priority
        for (int k = 1; k <= degree; k++) {
            if (!issue(cl + (int64_t)k * stride)) break;
            st_uniform++;
        }
    } else {
        // non-uniform: walk the pattern table
        uint64_t pf = cl;
        uint16_t sig = t.sig;
        for (int k = 0; k < degree; k++) {
            const PT_ENTRY &p = pt[sig];
            if (p.conf < PT_CONF_MIN || p.stride == 0) break;
            pf = (uint64_t)((int64_t)pf + p.stride);
            sig = next_sig(sig, p.stride);
            if (!issue(pf)) break;
            st_pattern++;
        }
    }
    t.last_stride = (int8_t)stride;
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
}

void CACHE::l1d_prefetcher_final_stats()
{
    std::cout << "CPU " << cpu << " L1D SPP final stats" << std::endl;
    std::cout << "Issued: " << st_issued << " Useful(tracked): " << st_useful
              << " Uniform: " << st_uniform << " Pattern: " << st_pattern
              << " Final degree: " << (int)degree << std::endl;
}
